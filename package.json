{
  "name": "clipqa-mcp",
  "version": "0.3.0",
  "description": "Background window recording, frame-level QA evidence, 360° orbit sheets and a structured review checklist for AI agents via MCP.",
  "type": "module",
  "bin": {
    "clipqa-mcp": "build/index.js"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "scripts/install-wgc.ps1",
    "docs/assets/banner.png",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx benchmarks/temporal-coverage.ts",
    "setup:wgc": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-wgc.ps1",
    "start": "node build/index.js",
    "prepack": "npm run build && npm test",
    "prepare": "tsc -p tsconfig.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "qa",
    "screen-recording",
    "roblox",
    "computer-vision",
    "testing",
    "3d",
    "animation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WheresRace/clipqa-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/WheresRace/clipqa-mcp/issues"
  },
  "homepage": "https://github.com/WheresRace/clipqa-mcp#readme",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
