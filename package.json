{
  "name": "clipqa-mcp",
  "version": "0.1.0",
  "description": "Background window recording and frame-level QA evidence for AI agents via MCP.",
  "type": "module",
  "bin": {
    "clipqa-mcp": "build/index.js"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx benchmarks/temporal-coverage.ts",
    "start": "node build/index.js",
    "prepack": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "qa",
    "screen-recording",
    "roblox",
    "computer-vision",
    "testing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WheresRace/clipqa-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/WheresRace/clipqa-mcp/issues"
  },
  "homepage": "https://github.com/WheresRace/clipqa-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.5.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
